# MATLAB autosaves / scratch
*.asv
*.m~
slprj/
*.slxc

# Excel lock files
~$*

# Auto-generated warm-start caches. MLTP.m solves one via MLTP_initial.m when
# no cache matches the current circuit + aero setting, so a fresh clone is fine
# without them. git add -f a specific file to version a known-good warm start.
Parameters/init_*.mat
Data/*/initialisation/init_*.mat

# Run-configuration override written by the batch/test harnesses
runOverride.mat

# Solver output
solutions/

# Per-user sim state: WHICH track the Simulink/3D routes are currently pointed
# at (simulink/tools/setupTrack.m writes both). activeTrack.mat names one
# machine's solved-lap sidecar by path and carries that lap's reference bake;
# trackRibbon_<TAG>.mat is the geometry sidecar generated beside it. Committing
# either would re-point a second person's sim at a track their checkout may not
# even hold - the same hazard runOverride.mat is ignored for. The shipped
# Barcelona ribbon, trackRibbon_BCN.mat, IS tracked: it is the default the
# public distribution falls back to when no solved lap is on hand.
simulink/data/activeTrack.mat
simulink/data/trackRibbon_*.mat
!simulink/data/trackRibbon_BCN.mat
